# Docker Compose 配置模板
# 复制为根目录 .env 后再执行：docker-compose up -d --build

# ========== LLM（兼容 OpenAI 格式） ==========
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_MODEL_ID=your_model
LLM_TIMEOUT=600
# 行程规划阶段单独的超时（秒，默认180）。规划 prompt 最长，通常需要更长时间
TRIP_PLANNER_TIMEOUT=680

# ========== 高德地图 ==========
# 后端 REST 服务 Key：地理编码、POI、天气、路线等
VITE_AMAP_WEB_KEY=your_amap_web_service_key
# 前端 Web端(JS API) Key：地图渲染
VITE_AMAP_WEB_JS_KEY=your_amap_web_js_key
# 前端 Web端(JS API) 安全密钥 JSCode：构建期注入 index.html
VITE_AMAP_SECURITY_JS_CODE=your_amap_security_js_code

# ========== 小红书 ==========
# 首次可在此填写，启动后会自动迁移到 backend/data/xhs.db 的加密会话表；
# 迁移后建议从 .env 删除，改在设置页导入。
XHS_COOKIE="a1=xxx; web_session=xxx; webId=xxx"
# Cookie 加密密钥（Fernet key，URL-safe base64，32 字节）。
# 留空时会在 backend/data/xhs_cookie.key 自动生成；生产环境建议通过密钥管理服务注入。
XHS_COOKIE_KEY=
# 小红书请求最小间隔（秒）与重试次数；默认单 worker 串行。
XHS_REQUEST_INTERVAL=4
XHS_REQUEST_RETRIES=2

# ========== 用户偏好记忆模块（可选） ==========
ENABLE_USER_MEMORY=false
MEMORY_THRESHOLD=2.0
MIN_INIT_WEIGHT=4.0
MEMORY_DECAY_FACTOR=0.97
MEMORY_MAX_RECALL=10
MEMORY_MAX_SINGLE_CONTENT=120
MEMORY_USE_SQLITE=false

# ========== 公开发布与防滥用 ==========
# 对外发布时设为 true：设置页变为只读（需管理员令牌），并对规划接口限流
PUBLIC_MODE=false
# 管理员令牌：PUBLIC_MODE=true 时，修改配置需携带 X-Admin-Token 请求头
ADMIN_TOKEN=
# 部署在 Nginx/CDN 后时设为 true，才能正确读取 X-Forwarded-For
TRUST_PROXY=false
# 单 IP 每天最多规划次数
PLAN_RATE_LIMIT_PER_DAY=5
# 单 IP 60 秒内最多提交次数
PLAN_BURST=2
# 全局同时执行的规划任务数
MAX_CONCURRENT_PLANS=2
# 排队上限（超出直接 429）
PLAN_QUEUE_LIMIT=20
